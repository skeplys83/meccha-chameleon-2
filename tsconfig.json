{
  "compilerOptions": {
    "target": "ES2017",
    // The browser half. `src/server/` is checked by tsconfig.server.json, which
    // drops "dom" — so a `window` reference on that side is a compile error
    // rather than something you find in production.
    "lib": ["dom", "dom.iterable", "esnext"],
    "types": ["vite/client", "node"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    // Node strips types itself and resolves the real file, so server/ imports
    // must name "./room.ts". Safe with noEmit.
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "src/client/**/*.ts",
    "src/client/**/*.tsx",
    "src/shared/**/*.ts",
    "src/main.tsx",
    "*.ts",
    "*.mts",
    "scripts/**/*.mjs"
  ],
  "exclude": ["node_modules", "dist"]
}
